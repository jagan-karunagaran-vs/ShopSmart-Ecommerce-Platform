# ─────────────────────────────────────────────────────────────
# ShopSmart Frontend — Environment Configuration
# Copy this file to .env (frontend/.env). Only variables that
# start with VITE_ are exposed to the browser, so never put
# secrets (Razorpay key secret, JWT secret, DB URI) in here.
# ─────────────────────────────────────────────────────────────

# Base URL of the backend API (no trailing slash).
# Local development: backend runs on port 5000.
# Production: use your deployed HTTPS API URL, e.g. https://api.yourdomain.com/api
VITE_API_URL=http://localhost:5000/api