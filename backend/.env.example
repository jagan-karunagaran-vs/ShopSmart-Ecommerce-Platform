# ShopSmart Backend — Environment Configuration
# This is a template. Keep real credentials only in backend/.env.
# Do not overwrite an existing configured .env with this template.
# Never commit .env or share API keys.

# Server
NODE_ENV=development
PORT=5000

# Frontend origin; no trailing slash.
CLIENT_URL=http://localhost:5174

# MongoDB Atlas
# URL-encode special characters in the database password.
MONGODB_URI=your_mongodb_atlas_connection_string

# Authentication
# Generate a secret using:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Cookies
AUTH_COOKIE_NAME=shopsmart_token
CSRF_COOKIE_NAME=shopsmart_csrf
COOKIE_EXPIRES_DAYS=7

# Use true for HTTPS production deployments.
COOKIE_SECURE=false

# Cross-site deployments require none with COOKIE_SECURE=true.
COOKIE_SAME_SITE=lax

# Leave empty for localhost.
COOKIE_DOMAIN=

# Password hashing
BCRYPT_SALT_ROUNDS=12

# Razorpay — TEST MODE
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_razorpay_test_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret
CURRENCY=INR

# Pricing
# Free delivery when the discounted subtotal is ABOVE 499.
FREE_DELIVERY_THRESHOLD=499
DELIVERY_CHARGE=49

# General API rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Authentication rate limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Admin bootstrap — used by src/scripts/createAdmin.js
# Public signup always creates ordinary users.
# Replace these placeholders before running create-admin.
# Remove ADMIN_PASSWORD from .env after successful admin creation.
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password

# Gemini AI product search — BACKEND ONLY
# Create an API key through https://aistudio.google.com/
# Use a project on the free tier to maintain the zero-cost requirement.
# Do not enable paid billing.
# Free-tier model availability and quotas can change.
# Never put this key in a VITE_ variable or frontend source code.
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# AI request controls currently live in code:
# - Provider request timeout: 25 seconds.
# - Maximum query length: 400 characters.
# - Maximum catalog size: 250 active, in-stock products.
# - Maximum returned results: 12.
# - Per-user limit: 5 searches per minute.
# - Shared limit: 100 searches per 24-hour window per backend process.
# In-memory limits reset on restart and are not shared across instances.
# These application limits are separate from Google's account quotas.
# No automatic retries or paid-provider fallback are configured.